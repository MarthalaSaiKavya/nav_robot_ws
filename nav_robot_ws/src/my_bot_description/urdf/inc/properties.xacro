<?xml version="1.0"?>
<!--
  ALL robot dimensions live here, in ONE place.

  Why? Nav2 (footprint), the Gazebo diff-drive plugin (wheel separation / radius),
  the ros2_control config and the lite simulator all need the SAME numbers.
  If the wheel separation in the URDF and in the drive plugin disagree, the
  robot will think it turned 90 degrees when it really turned 80. That shows up
  later as a "smeared map" and is very hard to debug - so we define it once.

  Units: metres, kilograms, radians (ROS standard, REP-103).

  Robot layout seen from above (x = forward, y = left):

            front (+x)
        +==============+
        |   (caster)   |
   (W)==|      +       |==(W)     W = driven wheel,  + = base_link origin
        |   (caster)   |          LiDAR sits 5 cm in front of base_link
        +==============+
            back (-x)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Chassis (the main box) ===================== -->
  <xacro:property name="chassis_length" value="0.36"/>   <!-- along x -->
  <xacro:property name="chassis_width"  value="0.30"/>   <!-- along y -->
  <xacro:property name="chassis_height" value="0.10"/>   <!-- along z -->
  <xacro:property name="chassis_mass"   value="3.0"/>
  <!-- base_link sits at wheel-axle height. The chassis box centre is this much above it: -->
  <xacro:property name="chassis_z_offset" value="0.03"/>

  <!-- ===================== Driven wheels ===================== -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.3"/>
  <!-- Distance between the CENTRES of the two wheels (left-right). -->
  <xacro:property name="wheel_separation" value="0.35"/>

  <!-- ===================== Casters (free-spinning balls) ===================== -->
  <!-- Slightly smaller than wheel_radius/2 so the driven wheels carry the weight
       (if the casters touch the floor too hard the wheels slip and odometry drifts). -->
  <xacro:property name="caster_radius" value="0.0245"/>
  <xacro:property name="caster_mass"   value="0.05"/>
  <xacro:property name="caster_x_offset" value="0.14"/>   <!-- front caster at +x, rear at -x -->

  <!-- ===================== LiDAR ===================== -->
  <xacro:property name="lidar_x" value="0.05"/>            <!-- 5 cm forward of base_link -->
  <xacro:property name="lidar_z" value="0.105"/>           <!-- scan plane 15.5 cm above the floor -->
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_length" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.2"/>
  <xacro:property name="lidar_min_range" value="0.12"/>
  <xacro:property name="lidar_max_range" value="12.0"/>
  <xacro:property name="lidar_samples" value="360"/>      <!-- 1 ray per degree -->
  <xacro:property name="lidar_rate" value="10"/>          <!-- Hz -->

  <!-- ===================== Camera (mounted ON the LiDAR: base -> lidar -> camera) ===================== -->
  <xacro:property name="camera_x" value="0.03"/>
  <xacro:property name="camera_z" value="0.05"/>

  <!-- ===================== Motion limits (used by the drive plugins) ===================== -->
  <xacro:property name="max_linear_velocity"  value="0.6"/>   <!-- m/s -->
  <xacro:property name="max_angular_velocity" value="2.5"/>   <!-- rad/s -->
  <xacro:property name="max_linear_acceleration"  value="1.5"/>
  <xacro:property name="max_angular_acceleration" value="4.0"/>

  <!-- Handy constant -->
  <xacro:property name="PI" value="3.14159265359"/>
</robot>
