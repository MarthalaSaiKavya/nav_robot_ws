<?xml version="1.0"?>
<!-- Colours used by RViz. (Gazebo uses the <gazebo><material> blocks / visual colours.) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="body_blue"><color rgba="0.15 0.35 0.75 1.0"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="caster_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="lidar_red"><color rgba="0.8 0.15 0.15 1.0"/></material>
  <material name="camera_white"><color rgba="0.95 0.95 0.95 1.0"/></material>
</robot>
