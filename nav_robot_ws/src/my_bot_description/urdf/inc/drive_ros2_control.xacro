<?xml version="1.0"?>
<!--
  DRIVE VARIANT B:  ros2_control + diff_drive_controller (the "professional" way).

  This is how most REAL robots are driven in ROS 2:
    * a hardware interface talks to the motors (here: gz_ros2_control talks to Gazebo,
      on a real robot it would talk to a motor driver over USB/CAN),
    * a generic, well-tested controller (diff_drive_controller) does the
      kinematics and odometry,
    * joint_state_broadcaster publishes /joint_states.
  Swapping simulation for real hardware = swapping ONE <plugin> line below.

  Data flow:
    /cmd_vel (Twist, from Nav2)
      -> twist_stamper node  (Jazzy's diff_drive_controller only accepts TwistStamped)
      -> /diff_drive_controller/cmd_vel (TwistStamped)
      -> controller -> wheel velocity commands -> Gazebo joints
    controller -> /diff_drive_controller/odom  (remapped to /wheel/odom_raw)

  Requires: sudo apt install ros-jazzy-gz-ros2-control ros-jazzy-ros2-controllers
  Controller settings: my_bot_description/config/ros2_controllers.yaml
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="drive_ros2_control">

    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20</param>
          <param name="max">20</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20</param>
          <param name="max">20</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <!-- Loads controller_manager INSIDE Gazebo. It reads robot_description from
           the robot_state_publisher node (default) and the controller yaml below. -->
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find my_bot_description)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
