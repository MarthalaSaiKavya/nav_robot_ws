<?xml version="1.0"?>
<!--
  GROUND TRUTH pose publisher (simulation-only "cheat").

  A real robot never knows its true pose - that is the whole point of SLAM/AMCL.
  In simulation we CAN know it, which lets us MEASURE how good our estimates are:
     localization error = | estimated pose (map->base_footprint) - true pose |

  Publishes nav_msgs/Odometry on /ground_truth/odom in the "world" frame
  (the room's centre). The evaluator node compares it with TF.
  Nothing in the navigation pipeline is allowed to use this topic!
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ground_truth">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/ground_truth/odom</odom_topic>
        <tf_topic>/ground_truth/tf</tf_topic>      <!-- not bridged: we never want this in /tf -->
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
