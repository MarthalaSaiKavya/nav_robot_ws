<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_bot_description</name>
  <version>1.0.0</version>
  <description>
    PHASE 1 - The robot's "body": URDF/xacro model of a small differential-drive
    robot (two driven wheels + two casters) with a 360 degree LiDAR, an IMU and an
    optional camera. Also contains the RViz view used to inspect the TF tree.
  </description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime tools needed to turn the xacro into a URDF and publish TF -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
