<?xml version="1.0"?>
<!--
  The robot BODY: base_footprint, base_link, chassis, two driven wheels, two casters.

  FRAME CONVENTIONS (REP-105 / REP-120), memorise these - every ROS robot uses them:

    base_footprint : a point on the FLOOR directly below the robot centre.
                     2D navigation (Nav2, SLAM, AMCL) reasons about this frame.
    base_link      : the robot's rigid body origin. Here: at wheel-axle height,
                     midway between the wheels.

  The TF tree produced by this file (robot_state_publisher publishes it):

     base_footprint
       └── base_link
             ├── chassis_link            (fixed)
             ├── left_wheel_link         (continuous - spins forever)
             ├── right_wheel_link        (continuous)
             ├── caster_front_link       (fixed)
             └── caster_rear_link        (fixed)

  Sensors are attached in sensors/*.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== base_footprint (root of the robot tree) ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link is lifted by the wheel radius so the wheels touch z=0 -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link carries no geometry itself; the chassis is a separate child link
       so that we can move the box around without moving the robot's reference frame. -->
  <link name="base_link"/>

  <!-- ===================== Chassis ===================== -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ===================== Driven wheels (a macro so left/right stay identical) ===================== -->
  <!--
    prefix   : "left" or "right"
    y_reflect: +1 for left (positive y), -1 for right
    The cylinder axis is z by default, so we roll it by -90deg (left) / +90deg (right)
    so that the wheel axis points along y. The joint axis "0 0 1" is then the
    wheel's own spin axis -> positive joint velocity == robot moves forward on BOTH sides.
  -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_separation / 2} 0" rpy="${-y_reflect * PI / 2} 0 0"/>
      <axis xyz="0 0 ${y_reflect}"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Rubber-like friction so the wheels grip (Gazebo reads mu1/mu2 from these tags). -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <!-- ===================== Casters (passive balls, almost no friction) ===================== -->
  <xacro:macro name="caster" params="prefix x_reflect">
    <joint name="caster_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefix}_link"/>
      <!-- centre of the ball sits caster_radius above the floor -->
      <origin xyz="${x_reflect * caster_x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="caster_${prefix}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster_grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>

    <!-- Near-zero friction: a caster must slide/roll freely in every direction,
         otherwise it fights the wheels when the robot turns. -->
    <gazebo reference="caster_${prefix}_link">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_reflect="1"/>
  <xacro:caster prefix="rear"  x_reflect="-1"/>

</robot>
