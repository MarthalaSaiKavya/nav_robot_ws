<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_bot_bringup</name>
  <version>1.0.0</version>
  <description>
    PHASES 2-9 - top-level launch files (one per phase + the single-command full mission),
    mission / scenario / odometry configuration and RViz layouts.
  </description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>my_bot_description</exec_depend>
  <exec_depend>my_bot_gazebo</exec_depend>
  <exec_depend>my_bot_navigation</exec_depend>
  <exec_depend>my_bot_autonomy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
